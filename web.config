<?xml version="1.0" encoding="utf-8"?>
<!-- 3DMP Service · отключаем кэш статики, чтобы обновления подхватывались сразу.
     Залить в корень сайта: sapfir.eu\saas\web.config -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
