# 3DMP · сервис снимков /shot — пример конфигурации (.env.example)
# Скопируйте в .env (не коммитить) или задайте переменные окружения в системе.

# Порт сервиса
PORT=8787

# Bearer-токен для /shot. Обязателен в бою. Пусто = без авторизации (только для локальной разработки).
SHOT_TOKEN=

# Разрешённые домены (allow-list), через запятую. Пример: sapfir.eu,example.com
# Пусто = любой публичный домен (всё равно блокируются приватные IP).
SHOT_ALLOWLIST=sapfir.eu

# CORS: список Origin через запятую, либо * (не рекомендуется в бою). Пусто = без CORS.
ALLOWED_ORIGINS=https://sapfir.eu

# Разрешить снимки приватных адресов (ОПАСНО; только локально). true|false
SHOT_ALLOW_PRIVATE=false

# Таймаут навигации, мс
SHOT_TIMEOUT_MS=20000
# Максимальная ширина снимка, px
SHOT_MAX_WIDTH=1920
# Параллельных снимков
SHOT_CONCURRENCY=2
